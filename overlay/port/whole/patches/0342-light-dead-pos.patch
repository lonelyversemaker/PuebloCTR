+/* PORT (patch 0342, C2a of the 3DS deep optimisation): for a type 5 (parallel) light LightSetModel, the room light loop and
+ * commonClothLightSet leave out the position they computed first (getPos, the view matrix, GXInitLightPos):
+ * lightSetParallel, always called for the type, writes the position of the same light object again, and nothing reads
+ * the local in between (getPos is an inline copy of World and always writes). About 870 lights a frame in the r104
+ * fight. The same bits. RE4_LIT_DEADPOS=0: computed as before. */
+#include <stdlib.h>
+extern "C" void re4_log(const char* fmt, ...);
+int re4_lit_deadpos = -1;
+
+int re4LitDeadposInit()
+{
+    const char* v = getenv("RE4_LIT_DEADPOS");
+    re4_lit_deadpos = !(v && *v == '0');
+    re4_log("light position (patch 0342, RE4_LIT_DEADPOS %d): the first position of a parallel light %s",
+            re4_lit_deadpos, re4_lit_deadpos ? "left out" : "computed");
+    return re4_lit_deadpos;
+}
