# Port patch 0343 (2026-11-22; docs/23 C4): BP registers no one reads on the
# 3DS are left out in the GX library under RE4_GX_DEAD (re4_gx_fifo.h; 0 off the 3DS): the rasteriser's texture sizes
# 0x30-0x3F (__GXSetSUTexRegs not called), GXSetDstAlpha's 0x42, a texture's image1 / image2. RE4_3DS_DEADREGS=0: as before.
diff -ruN a/src/lib/GXGeometry.c b/src/lib/GXGeometry.c
--- a/src/lib/GXGeometry.c	2026-11-22 21:47:44.123796970 +0900
+++ b/src/lib/GXGeometry.c	2026-11-22 21:47:44.450676855 +0900
@@ -7,7 +7,7 @@
 void __GXSetDirtyState(void) {
     u32 dState = __GXData->dirtyState;
 
-    if (dState & 1) {
+    if ((dState & 1) && !RE4_GX_DEAD(1)) {  /* port (patch 0343): the texture sizes no one reads on the 3DS */
         __GXSetSUTexRegs();
     }
     if (dState & 2) {
diff -ruN a/src/lib/GXPixel.c b/src/lib/GXPixel.c
--- a/src/lib/GXPixel.c	2026-11-22 21:47:44.115772372 +0900
+++ b/src/lib/GXPixel.c	2026-11-22 21:47:44.451108358 +0900
@@ -303,7 +303,7 @@
 
     SET_REG_FIELD(584, reg, 8, 0, alpha);
     SET_REG_FIELD(585, reg, 1, 8, enable);
-    GX_WRITE_RAS_REG(reg);
+    if (!RE4_GX_DEAD(2)) GX_WRITE_RAS_REG(reg);  /* port (patch 0343): no reader on the 3DS */
 
     __GXData->cmode1 = reg;
     __GXData->bpSentNot = 0;
diff -ruN a/src/lib/GXTexture.c b/src/lib/GXTexture.c
--- a/src/lib/GXTexture.c	2026-11-22 21:47:44.156171323 +0900
+++ b/src/lib/GXTexture.c	2026-11-22 21:47:44.451513611 +0900
@@ -637,8 +637,8 @@
     GX_WRITE_RAS_REG(t->mode0);
     GX_WRITE_RAS_REG(t->mode1);
     GX_WRITE_RAS_REG(t->image0);
-    GX_WRITE_RAS_REG(r->image1);
-    GX_WRITE_RAS_REG(r->image2);
+    if (!RE4_GX_DEAD(4)) GX_WRITE_RAS_REG(r->image1);  /* port (patch 0343): no reader on the 3DS */
+    if (!RE4_GX_DEAD(4)) GX_WRITE_RAS_REG(r->image2);
     GX_WRITE_RAS_REG(t->image3);
 
     if (!(t->flags & 2)) {
