 void re4EspBatchBefore(void (*func)(void*), u16 kind); /* port (patch 0339): esp_sub.cpp */
-void re4EspBatchFlush(); /* port (patch 0339) */
+void re4EspBatchFlush(); /* port (patch 0339) */ extern int re4_mr_pending; void re4MrReset(); void ModelRender(cModel* m); /* port (patch 0344) */
 
 int ExecOt(int type)
 {
@@ -293,7 +293,7 @@
         for (; p; p = p->next) {
             if (p->data) {
                 count++;
-                re4EspBatchBefore(p->func, p->kind); /* port (patch 0339): a sprite batch drawn first */
+                if (re4_mr_pending && p->func != (void (*)(void*)) ModelRender) re4MrReset(); re4EspBatchBefore(p->func, p->kind); /* port (patch 0339): a sprite batch drawn first; (patch 0344) a model's reset before another kind */
                 re4_gx_owner(p->data, (void*) p->func, type); /* port: the entry's object (patch 0137) */
                 g_OtSerial++;  // port (3.6)
                 g_OtCurFunc = p->func;
@@ -302,7 +302,7 @@
                 w->prev_kind = p->kind;
             }
         }
-        re4EspBatchFlush(); /* port (patch 0339) */
+        if (re4_mr_pending) re4MrReset(); re4EspBatchFlush(); /* port (patch 0339, 0344) */
         re4_gx_owner(0, 0, type); /* port: no object after the table */
     }
     GXSetAlphaCompare(7, 0, 1, 7, 0);
