+/* PORT (patch 0346, C5 of the 3DS deep optimisation): specular_mat at its first read. commonModelTrans computed it for
+ * every info of a model (updateMatrices: Concat with the camera, Inverse, Transpose) while only the specular, the bump
+ * specular and the global illumination setups read it. Now the two inputs are copied (the model's matrix - a local in
+ * the scaled case - and the camera's as it is then) and the same three operations run before the first read
+ * (re4SpecGet at the three reads). Where the normal matrices live (re4_gx_nrm_dead 0) updateMatrices still runs, into
+ * a scratch matrix, for its GXSetIndTexMtx. RE4_SPEC_LAZY=0: as before. */
+#include <string.h>
+static int gSpecLazy = -1;
+static int re4SpecPend;
+static Mtx re4SpecIn, re4SpecCam;
+
+static int re4SpecStash(Mtx in, cModel* m)
+{
+    if (gSpecLazy < 0) {
+        const char* v = getenv("RE4_SPEC_LAZY");
+        gSpecLazy = !(v && *v == '0');
+        re4_log("specular matrix (patch 0346, RE4_SPEC_LAZY %d): %s", gSpecLazy,
+                gSpecLazy ? "at its first read" : "for every info");
+    }
+    if (!gSpecLazy) {
+        return 0;
+    }
+    if (!re4_gx_nrm_dead) {
+        Mtx scratch;
+        updateMatrices(in, scratch, m);
+    }
+    memcpy(re4SpecIn, in, sizeof(Mtx));
+    memcpy(re4SpecCam, pG->Camera.v_mat, sizeof(Mtx));
+    re4SpecPend = 1;
+    return 1;
+}
+
+static void re4SpecGet()
+{
+    Mtx mv;
+    Mtx inv;
+
+    if (!re4SpecPend) {
+        return;
+    }
+    re4SpecPend = 0;
+    PSMTXConcat(re4SpecCam, re4SpecIn, mv);
+    PSMTXInverse(mv, inv);
+    PSMTXTranspose(inv, specular_mat);
+}
