+    f32 col[3]; if (re4LitColFast(lobj, pLi, pMod)) return;
     GXColor c;
     f32 r = (f32) pLi->DispCol.r;
     f32 g = (f32) pLi->DispCol.g;
@@ -522,7 +522,7 @@
     c.g = (u8) col[1];
     c.b = (u8) col[2];
     c.a = 0x80;
-    GXInitLightColor(lobj, c);
+    GXInitLightColor(lobj, c); re4LitColKeep(c);  /* port (patch 0346) */
 }
 
 // Ambient colour of both colour channels.
@@ -560,3 +560,58 @@
             re4_lit_deadpos, re4_lit_deadpos ? "left out" : "computed");
     return re4_lit_deadpos;
 }
+
+/* PORT (patch 0346, C2b of the 3DS deep optimisation): lightSetColor's result depends on the four bytes of DispCol
+ * alone but in the branch of an enemy's light area. A table of 64 places keyed by that word gives the colour computed
+ * for it before (stored by the computation itself: re4LitColKeep); the area branch goes the whole way.
+ * RE4_LIT_COLMEMO=0: as before. */
+#include <string.h>
+static int gLitColMemo = -1;
+static int re4ColSlot = -1;
+static u32 re4ColPend;
+static u32 re4ColKey[64];
+static GXColor re4ColVal[64];
+static u8 re4ColOk[64];
+
+static int re4LitColFast(GXLightObj* lobj, cLight* pLi, cEm* pMod)
+{
+    u32 key;
+    int slot;
+
+    re4ColSlot = -1;
+    if (gLitColMemo < 0) {
+        const char* v = getenv("RE4_LIT_COLMEMO");
+        gLitColMemo = !(v && *v == '0');
+        re4_log("light colour (patch 0346, RE4_LIT_COLMEMO %d): %s", gLitColMemo,
+                gLitColMemo ? "from the table" : "computed");
+    }
+    if (!gLitColMemo) {
+        return 0;
+    }
+    if (pMod != NULL) {
+        cModelState* la = &pMod->State;
+
+        if (la->IsLightIgnore() == 1 && la->IsLightIgnoreUse() == 1 && la->GetLightNo() == pLi->LitIndex) {
+            return 0;
+        }
+    }
+    memcpy(&key, &pLi->DispCol, 4);
+    slot = (int) ((key * 0x9E3779B1u) >> 26);
+    if (re4ColOk[slot] && re4ColKey[slot] == key) {
+        GXInitLightColor(lobj, re4ColVal[slot]);
+        return 1;
+    }
+    re4ColSlot = slot;
+    re4ColPend = key;
+    return 0;
+}
+
+static void re4LitColKeep(GXColor c)
+{
+    if (re4ColSlot >= 0) {
+        re4ColKey[re4ColSlot] = re4ColPend;
+        re4ColVal[re4ColSlot] = c;
+        re4ColOk[re4ColSlot] = 1;
+        re4ColSlot = -1;
+    }
+}
