+
+/* PORT (patch 0347, D1 of the 3DS deep optimisation): EmAtCheck's walk over the objects that collide.
+ * re4_at_gen counts the changes of bit 0x200 in the flags of ObjMgr's works (re4AtFlag, atariInfo.h) and the clears
+ * of a whole cAtariInfo; with re4_list_gen it tells that the objects EmAtCheck kept at its last whole walk are still
+ * all that have the bit. RE4_AT_KEPT: 1 on (default), 0 the whole walk as before, 2 with a count in the log,
+ * 3 checked against the whole walk (a difference stops the game). */
+#include <stdlib.h>
+#include <stddef.h>
+extern "C" void re4_log(const char* fmt, ...);
+extern "C" {
+u32 re4_at_gen;
+void re4_at_changed(void* flag)
+{
+    /* a body outside ObjMgr's array (an enemy, the player): the walks over those read the flag itself */
+    const u8* lo = (const u8*) ObjMgr.pArray;
+    if (flag == 0 || lo == 0 || ObjMgr.pArrayPush != 0 || (u32) ((const u8*) flag - lo) < ObjMgr.nArray * ObjMgr.size) {
+        re4_at_gen++;
+    }
+}
+}
+typedef char re4AtFlagSize[sizeof(re4AtFlag) == 2 && offsetof(cAtariInfo, m_flag) == 0x1A && offsetof(cAtariInfo, m_radius_n) == 0x1C ? 1 : -1];
+
+static int re4AtKeptMode()
+{
+    static int mode = -1;
+    if (mode < 0) {
+        const char* v = getenv("RE4_AT_KEPT");
+        mode = v && *v >= '0' && *v <= '3' ? *v - '0' : 1;
+        re4_log("at kept (patch 0347, RE4_AT_KEPT %d): %s", mode,
+                mode == 0 ? "EmAtCheck walks all objects" : mode == 3 ? "the kept objects, checked against the whole walk"
+                                                                      : "EmAtCheck walks the kept objects");
+    }
+    return mode;
+}
+
+static void re4AtKeptNote(int mode, int kept, cObj** hit, u32 nHit, int over)
+{
+    static unsigned long long calls, keptCalls, gens, lastGen;
+    calls++;
+    keptCalls += kept;
+    if (mode == 3 && kept) {
+        cObj* o;
+        u32 n = 0;
+        int bad = 0;
+        for (o = ObjMgr.getActiveWork(); o != 0; o = ObjMgr.getNext(o)) {
+            if ((o->atari.m_flag & 0x200) && o->atari.m_radius2 != 0.0f) {
+                if (n < 64 && (n >= nHit || hit[n] != o)) {
+                    bad = 1;
+                }
+                n++;
+            }
+        }
+        if (bad || (n <= 64 ? n != nHit || over : !over)) {
+            re4_log("at kept: MISMATCH (the whole walk %u objects, the kept one %u, over %d; call %llu)", (unsigned) n,
+                    (unsigned) nHit, over, calls);
+            abort();
+        }
+    }
+    if (!kept) {
+        gens += lastGen != re4_at_gen;
+        lastGen = re4_at_gen;
+    }
+    if (calls % 2000 == 0) {
+        re4_log("at kept: %llu calls, %llu over the kept objects, %llu whole walks after a flag change (re4_at_gen %u)",
+                calls, keptCalls, gens, (unsigned) re4_at_gen);
+    }
+}
