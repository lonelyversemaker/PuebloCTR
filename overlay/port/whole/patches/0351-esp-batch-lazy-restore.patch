+// (patch 0351) the state the last sprite left - after the batch, or owed until here
+static void espBatchRestore()
+{
+    GXSetChanCtrl(4, 0, 0, 0, 0, 0, 2);
+    GXSetChanMatColor(4, s_espBatch.lastCol);
+    s_espRun.col = s_espBatch.lastCol;
+    s_espRun.haveCol = 1;
+    {
+    GXClearVtxDesc();
+    GXSetVtxDesc(9, 1);
+    GXSetVtxDesc(0xA, 1);
+    GXSetVtxDesc(0xD, 1);
+    GXSetVtxAttrFmt(0, 9, 1, 1, 0);
+    GXSetVtxAttrFmt(0, 0xA, 0, 1, 0);
+    GXSetVtxAttrFmt(0, 0xD, 1, 1, 0);
+    }
+    GXLoadPosMtxImm(s_espBatch.lastMat, 0);
+    GXSetCurrentMtx(0);
+    s_espRun.haveMtx = 1;
+    s_espOwed = 0;
+}
