+// (patch 0351) the batch drawn and the state paid back (as patch 0339 always did), or a debt paid
 void re4EspBatchFlush()
 {
-    const int n = s_espBatch.n;
-    if (n == 0) {
-        return;
+    if (s_espBatch.n > 0) {
+        espBatchFlushBody(0);
+    } else if (s_espOwed) {
+        s_espPaidN++;
+        espBatchRestore();
+    }
+}
+
+// (patch 0351) the batch drawn; with RE4_ESP_LAZY the restore owed (a batch opens right after)
+static void espBatchFlushOwe()
+{
+    if (re4_esp_lazy < 0) {
+        const char* e = getenv("RE4_ESP_LAZY");
+        re4_esp_lazy = e ? atoi(e) : 1;
+    }
+    if (s_espBatch.n > 0) {
+        espBatchFlushBody(re4_esp_lazy > 0);
     }
+}
