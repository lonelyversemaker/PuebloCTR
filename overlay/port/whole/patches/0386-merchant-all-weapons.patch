# Port patch 0386 (2026-11-27, the 3DS settings' cheat "All weapons at the merchant", runtime/cheats.cpp
# re4_merchant_weapons): a shop visit offers every weapon its price table prices (not 0x17, not 0x40), one piece
# each, at the game's prices; Merchant::save leaves them out of the merchant's data - the card never keeps the
# offer. Hooks on existing lines (byte views keep their line numbers), the code at the file's end.
diff -ruN a/src/game/merchant.cpp b/src/game/merchant.cpp
--- a/src/game/merchant.cpp	2026-11-27 18:21:06.138379320 +0900
+++ b/src/game/merchant.cpp	2026-11-27 18:21:06.450606676 +0900
@@ -1595,7 +1595,7 @@
 }
 
 // Shop session object (sub screen): copies the character's tables and loads its data.
-Merchant::Merchant(MerchantCharacter* c)
+void re4ShopOffer(STOCK_INFO* st, PRICE_INFO* sell); void re4ShopKeepOwn(MERCHANT_DATA* d); Merchant::Merchant(MerchantCharacter* c)
 {
     m_p_info = c->m_p_info;
     m_p_sell = c->m_p_sell;
@@ -1603,7 +1603,7 @@
     m_p_lvup = c->m_p_lvup;
     memclr_asm(&m_stock, sizeof(STOCK_INFO));
     memclr_asm(&level, sizeof(LEVEL_INFO));
-    load(c->m_p_data);
+    load(c->m_p_data); re4ShopOffer(&m_stock, m_p_sell);  /* port (patch 0386): the 3DS cheat, this visit only */
 }
 
 // Writes the session's stock/tune/favor/discount back into the merchant data.
@@ -1614,7 +1614,7 @@
     p_data->friendship = m_friendship;
     p_data->study_num = m_study_num;
     p_data->reduction_ratio = m_reduction_ratio;
-    p_data->bonus_flag = m_bonus_flag;
