+// ---------------------------------------- the lists behind: advance() on the game's thread
+// What voice() leaves of a voice for AX, without its samples: Reader's address steps (fill(), next<>(), atEnd())
+// for the samples sourceAs() reads, its fraction, the volume envelope; the updates of each millisecond.
+struct Steps {
+    u32 cur, end, loop;
+    bool loops, stopped;
+
+    void atEnd()
+    {
+        if (loops) {
+            cur = loop;
+        } else {
+            cur = end;
+            stopped = true;
+        }
+    }
+
+    void adpcm(u32 n)
+    {
+        while (n && !stopped) {
+            if (end - cur <= 15 - (cur & 15) || ((cur | 15) >> 1) >= 0x1000000) {  // fill(): sample by sample
+                const u32 at = cur;
+                u32 a = cur;
+                if ((a & 15) == 0) {
+                    a += 2;
+                }
+                cur = a + 1;
+                n--;
+                if (a == end || at == end) {
+                    atEnd();
+                }
+                continue;
+            }
+            u32 a = cur;
+            if ((a & 15) == 0) {
+                a += 2;
+            }
+            u32 k = 16 - (a & 15);
+            if (k > n) {
+                k = n;
+            }
+            n -= k;
+            cur = a + k;
+        }
+    }
+
+    void pcm(u32 n)
+    {
+        while (n && !stopped) {
+            if (end - cur >= n) {  // none of the n at the end address
+                cur += n;
+                return;
+            }
+            const u32 at = cur++;
+            n--;
+            if (at == end) {
+                atEnd();
+            }
+        }
+    }
+};
+
+void advance(AXPB& pb)
+{
+    for (int ms = 0; ms < 5; ms++) {
+        updates(pb, ms, nullptr);
+        if (pb.state != 1) {
+            continue;
+        }
+        u32 frac = pb.src.currentAddressFrac;
+        u32 ratio = hilo(pb.src.ratioHi, pb.src.ratioLo);
+        if (pb.srcSelect == 2) {
+            ratio = 0x10000;
+            frac = 0;
+        }
+        if (ratio > 0x40000) {
+            ratio = 0x40000;
+        }
+        const u32 total = frac + kMs * ratio;
+        Steps s = {hilo(pb.addr.currentAddressHi, pb.addr.currentAddressLo),
+                   hilo(pb.addr.endAddressHi, pb.addr.endAddressLo),
+                   hilo(pb.addr.loopAddressHi, pb.addr.loopAddressLo), pb.addr.loopFlag != 0, false};
+        if (pb.addr.format == 0) {
+            s.adpcm(total >> 16);
+        } else {
+            s.pcm(total >> 16);
+        }
+        pb.addr.currentAddressHi = (u16) (s.cur >> 16);
+        pb.addr.currentAddressLo = (u16) s.cur;
+        if (s.stopped) {
+            pb.state = 0;
+        }
+        pb.src.currentAddressFrac = (u16) total;
+        pb.ve.currentVolume = (u16) (pb.ve.currentVolume + kMs * pb.ve.currentDelta);
+    }
+}
+
+void behindAfter(const AXPB& pb, u16* after)
+{
+    after[0] = pb.state;
+    after[1] = pb.addr.currentAddressHi;
+    after[2] = pb.addr.currentAddressLo;
+    after[3] = pb.src.currentAddressFrac;
+    after[4] = pb.ve.currentVolume;
+}
