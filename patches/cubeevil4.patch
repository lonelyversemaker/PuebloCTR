+// ---------------------------------------- the lists behind: the worker's side
+// AXSPB.c __AXDepopVoice: a voice's depop values into the sums
+void addDepop(const AXPBDPOP& d)
+{
+    gDepopSum[L] += d.aL;
+    gDepopSum[AL] += d.aAuxAL;
+    gDepopSum[BL] += d.aAuxBL;
+    gDepopSum[R] += d.aR;
+    gDepopSum[AR] += d.aAuxAR;
+    gDepopSum[BR] += d.aAuxBR;
+    gDepopSum[S] += d.aS;
+    gDepopSum[AS] += d.aAuxAS;
+    gDepopSum[BS] += d.aAuxBS;
+}
+
+// AXSPB.c __AXDepopFade: a bus's sum into the studio's start value and delta
+void fadeDepop(int b)
+{
+    s32& sum = gDepopSum[b];
+    if (sum / 160) {
+        s32 delta = sum / 160;
+        if (delta > 0x14) {
+            delta = 0x14;
+        }
+        if (delta < -0x14) {
+            delta = -0x14;
+        }
+        gStudio[b] = sum;
+        sum -= delta * 0xA0;
+        gStudioDelta[b] = (s16) -delta;
+        return;
+    }
+    sum = 0;
+    gStudio[b] = 0;
+    gStudioDelta[b] = 0;
+}
