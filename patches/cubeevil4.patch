+                }
+            }
+        }
+        s.mix = pb.mix;
+        s.dpop = pb.dpop;
+        s.predScale = pb.adpcm.pred_scale;
+        s.yn1 = pb.adpcm.yn1;
+        s.yn2 = pb.adpcm.yn2;
+        memcpy(s.last, pb.src.last_samples, sizeof(s.last));
+        s.lpfYn1 = pb.lpf.yn1;
+    }
