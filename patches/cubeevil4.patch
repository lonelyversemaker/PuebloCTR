+// The file becomes <file>.1, a new one starts.
+void rotate()
+{
+    trim();
+    close(gFile);
+    remove((gFilePath + ".1").c_str());  // (the 3DS's SD card renames onto no file: the log emptied, its start lost)
+    rename(gFilePath.c_str(), (gFilePath + ".1").c_str());
+    gFile = open(gFilePath.c_str(), openFlags() | O_TRUNC, 0644);
+    gFileSize = 0;
+    gFileRoom = 0;
+}
+
+// Text into the file, a new one past the limit.
+void put(const char* text, int n)
+{
+    if (gFileSize + n > gFileLimit) {
+        rotate();
+        if (gFile < 0) {
+            return;
+        }
+    }
+    if (!gReserve) {
+        if (write(gFile, text, (size_t) n) == n) {
+            gFileSize += n;
+        }
+        return;
+    }
+    if (gFileSize + n > gFileRoom) {
+        makeRoom(gFileSize + n + gReserve);  // more than gReserve in one run: found in the game, as before
+    }
+    if (writeAt(text, (size_t) n, gFileSize)) {
+        gFileSize += n;
+    }
+}
