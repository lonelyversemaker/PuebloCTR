+// 0x03 behind: the frame's voices with the worker's state where the CPU did not write it
+void processBehind()
+{
+    BehindFrame& f = *gRunning;
+    u32 running = 0;
+    for (u32 i = 0; i < f.voices; i++) {
+        BehindVoice& v = f.voice[i];
+        AXPB& pb = v.pb;
+        BehindState& s = gState[v.index];
+        const u32 sync = v.sync;
+        if (!(sync & AX_SYNC_FLAG_COPYALL)) {
+            if (!(sync & AX_SYNC_FLAG_COPYAXPBMIX)) {
+                pb.mix = s.mix;
+            }
+            if (!(sync & AX_SYNC_FLAG_COPYDPOP)) {
+                pb.dpop = s.dpop;
+            }
+            if (!(sync & AX_SYNC_FLAG_COPYADPCM)) {
+                pb.adpcm.pred_scale = s.predScale;
+                pb.adpcm.yn1 = s.yn1;
+                pb.adpcm.yn2 = s.yn2;
+            }
+            if (!(sync & AX_SYNC_FLAG_COPYSRC)) {
+                memcpy(pb.src.last_samples, s.last, sizeof(s.last));
+            }
+            if (!(sync & 0x200000) || (sync & 0x400000)) {  // (__AXServiceVPB: 0x400000 returns before the LPF)
+                pb.lpf.yn1 = s.lpfYn1;
+            }
