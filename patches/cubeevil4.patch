+            gHeadStats.noRoom[side]++;
+            return nullptr;
+        }
+        c.gen = g.gen;
+        c.at = gHeadFree[--gHeadFreeN];
+        c.left = kHeadChunk;
+        g.chunks[g.nChunks++] = c.at;
+    }
+    u8* p = c.at;
+    c.at += bytes;
+    c.left -= bytes;
+    return p;
+}
+
+// A model's vertices are skinned (re4_gx_head_job): the heads of the lists that read them
+void headJob(int side, u32 gen, const void* src, const u8* pos, u32 posN, const u8* nrm, u32 nrmN, int nrmKind)
+{
+    HeadGen& g = gHeadGens[gen % kHeadGens];
+    HeadPlan* plans[kHeadPerSrc];
+    u32 n = 0;
+    const u64 from = svcGetSystemTick();
+    {
+        std::lock_guard<std::mutex> lock(gHeadMutex);
+        if (g.gen != gen) {
+            // the place of the generation four before: its pieces went at an announce since (else this thread is too
+            // far ahead: no heads this time)
+            if (g.nChunks || (gHeadNow != ~0u && (int) (gen - gHeadNow) > (int) kHeadGens - 1)) {
+                gHeadStats.lapped[side]++;
+                return;
+            }
+            g.gen = gen;
+            g.used = 0;
+        }
+        HeadEntry* e = headPut(g, pos, 0);
+        if (!e) {
+            gHeadStats.full[side]++;
+            return;
+        }
+        e->nrm = nrm;
+        e->buf = nullptr;
+        e->src = src;
+        e->posN = posN;
+        e->nrmN = nrmN;
+        e->nrmKind = nrmKind;
+        if (const HeadSrc* s = headSrc(src, false)) {
+            for (u32 i = 0; i < s->n; i++) {
+                plans[n] = s->plans[i];
+                __atomic_add_fetch(&plans[n]->refs, 1, __ATOMIC_SEQ_CST);
+                n++;
+            }
+        }
+    }
+    gHeadStats.models[side]++;
+    u8* bufs[kHeadPerSrc];
+    float boxes[kHeadPerSrc][6];
+    for (u32 i = 0; i < n; i++) {
+        const HeadPlan& p = *plans[i];
+        bufs[i] = nullptr;
+        if (p.posTop > posN || (p.head == 16 && (nrmKind != 1 || p.nrmTop > nrmN))) {
+            continue;
+        }
+        bufs[i] = headRoom(side, g, p.count * p.head);
+        if (bufs[i]) {
+            headDirect(pos, 6, p.idx, nrm, 3, p.idx + p.count, p.count, p.head, p.scale, bufs[i], boxes[i]);
+            gHeadStats.made[side]++;
+            gHeadStats.madeVertices[side] += p.count;
+        }
+    }
+    {
+        std::lock_guard<std::mutex> lock(gHeadMutex);
+        for (u32 i = 0; i < n; i++) {
+            if (!bufs[i]) {
+                continue;
+            }
+            HeadEntry* e = headPut(g, pos, plans[i]->id);
+            if (!e) {
+                gHeadStats.full[side]++;
+                break;
+            }
+            e->nrm = nrm;
+            e->buf = bufs[i];
+            memcpy(e->box, boxes[i], sizeof(e->box));
+        }
+    }
+    for (u32 i = 0; i < n; i++) {
+        headUnref(plans[i]);
+    }
+    gHeadStats.ticks[side] += svcGetSystemTick() - from;
+}
+
+// (the GX thread) The record after a generation's jobs: the draws from here read its arrays
+void headAnnounce(u32 gen)
+{
+    std::lock_guard<std::mutex> lock(gHeadMutex);
+    if (!gHeadGensInit) {
+        gHeadGensInit = true;
+        for (HeadGen& g : gHeadGens) {
+            g.gen = ~0u;
+        }
+        const char* kb = getenv("RE4_3DS_HEADJOBKB");
+        gHeadChunksCap = (u32) (kb ? atoi(kb) : 3072) * 1024 / kHeadChunk;
+        gHeadChunksCap = gHeadChunksCap > kHeadChunksMax ? kHeadChunksMax : gHeadChunksCap;
+        gHeadShort = 1;
+    }
+    for (HeadGen& g : gHeadGens) {
+        if (g.gen != ~0u && g.gen != gen && (int) (gen - g.gen) > 0 && g.nChunks) {
+            for (u32 c = 0; c < g.nChunks; c++) {
+                gDirect->later(g.chunks[c]);
+            }
+            g.nChunks = 0;
+        }
+    }
+    gHeadNow = gen;
+    if (gHeadShort) {  // more pieces (8 at a time, to the cap)
+        gHeadShort = 0;
+        for (u32 n = 0; n < 8 && gHeadChunks < gHeadChunksCap; n++) {
+            u8* p = (u8*) linearAlloc(kHeadChunk);
+            if (!p) {
+                break;
+            }
+            gHeadFree[gHeadFreeN++] = p;
+            gHeadChunks++;
+        }
+    }
+    if ((++gHeadAnnounces & 63) == 0) {  // the plans whose heads no draw took for a while: not made any more
+        for (HeadSrc& s : gHeadSrc) {
+            for (u32 i = 0; i < s.n;) {
+                if ((int) (gDirectFrames - s.plans[i]->lastUsed) > 120) {
+                    s.plans[i]->listed = false;
+                    s.plans[i] = s.plans[--s.n];
+                    gHeadStats.pruned++;
+                } else {
+                    i++;
+                }
+            }
+        }
+    }
+}
+
+// (the renderer, the GX thread) A piece the GPU is past
+void headBack(void* p)
+{
+    std::lock_guard<std::mutex> lock(gHeadMutex);
+    if (gHeadFreeN < kHeadChunksMax) {
+        gHeadFree[gHeadFreeN++] = (u8*) p;
+    }
+}
+
+// The list goes: its plan off the source, the jobs at work with it keep it till they are through
+void headForget(Kept& k)
+{
+    if (!k.plan) {
+        return;
+    }
+    {
+        std::lock_guard<std::mutex> lock(gHeadMutex);
+        if (k.plan->listed) {
+            if (HeadSrc* s = headSrc(k.plan->src, false)) {
+                for (u32 i = 0; i < s->n; i++) {
+                    if (s->plans[i] == k.plan) {
+                        s->plans[i] = s->plans[--s->n];
+                        break;
+                    }
+                }
+            }
+        }
+    }
+    headUnref(k.plan);
+    k.plan = nullptr;
+}
+
+// The head a job made for this draw (its box at box), or NULL
+u8* headReady(const Kept& k, const DrawArrays& arrays, u32 count, u32 head, float* box)
+{
+    if (re4_gx_head_on <= 0 || !k.plan || gHeadNow == ~0u) {
+        return nullptr;
+    }
+    HeadPlan& p = *k.plan;
+    const Array& pos = arrays.a[0];
+    const Array& nrm = arrays.a[1];
+    if (p.head != head || p.count != count || pos.stride != 6 || !keptFits(pos, p.posTop, 6) ||
+        (head == 16 && (nrm.stride != 3 || !keptFits(nrm, p.nrmTop, 3)))) {
+        return nullptr;
+    }
+    std::unique_lock<std::mutex> lazyLock(gHeadMutex, std::defer_lock);
+    if (gSkinNeedGen != ~0u) {  // (patch 0352) jobs of this generation still write its table
+        lazyLock.lock();
+    }
+    const HeadEntry* e = headFind(gHeadNow, pos.base, p.id);
+    if (!e || !e->buf || (head == 16 && e->nrm != nrm.base)) {
+        return nullptr;
+    }
+    memcpy(box, e->box, sizeof(e->box));
+    p.lastUsed = gDirectFrames;
+    gHeadStats.used++;
+    gHeadStats.usedVertices += count;
+    return e->buf;
+}
+
+// The list was converted here: if a job of this generation filled its positions, its plan to that model's source
+void headLearn(Kept& k, const Format& f, const DrawArrays& arrays, u32 count, u32 head)
+{
+    gHeadStats.here++;
+    gHeadStats.hereVertices += count;
+    if (re4_gx_head_on <= 0 || gHeadNow == ~0u || (k.plan && k.plan->listed) || !count) {
+        return;
+    }
+    const Array& pos = arrays.a[0];
+    const Array& nrm = arrays.a[1];
+    if (f.posFormat != 3 || f.posComps != 3 || pos.stride != 6 || ((uintptr_t) pos.base & 1) || !k.posIdx ||
+        gHeadFastFrom <= 0 || gHeadDirectFrom <= 0) {
+        return;
+    }
+    if (head == 16 &&
+        (f.nrmFormat != 1 || f.nrmComps * f.nrmCs != 3 || nrm.stride != 3 || !k.nrmIdx || gPackS8From <= 0)) {
+        return;
+    }
+    const HeadEntry* e;
+    {
+        std::unique_lock<std::mutex> lazyLock(gHeadMutex, std::defer_lock);
+        if (gSkinNeedGen != ~0u) {  // (patch 0352) jobs of this generation still write its table
+            lazyLock.lock();
+        }
+        e = headFind(gHeadNow, pos.base, 0);
+        if (!e || (head == 16 && (e->nrm != nrm.base || e->nrmKind != 1))) {
+            return;
+        }
+    }
+    if (!k.plan) {
+        const u32 words = head == 16 ? 2 * count : count;
+        HeadPlan* p = (HeadPlan*) malloc(sizeof(HeadPlan) + (size_t) words * sizeof(u16));
+        if (!p) {
+            return;
+        }
+        if (!k.posTop) {
+            k.posTop = keptTop(k.posIdx, count);
+        }
+        if (head == 16 && !k.nrmTop) {
+            k.nrmTop = keptTop(k.nrmIdx, count);
+        }
+        p->refs = 1;
+        p->id = ++gHeadIds ? gHeadIds : ++gHeadIds;
+        p->count = count;
+        p->head = head;
+        p->posTop = k.posTop;
+        p->nrmTop = head == 16 ? k.nrmTop : 0;
+        p->scale = f.posScale;
+        p->src = nullptr;
+        p->listed = false;
+        memcpy(p->idx, k.posIdx, (size_t) count * sizeof(u16));
+        if (head == 16) {
+            memcpy(p->idx + count, k.nrmIdx, (size_t) count * sizeof(u16));
+        }
+        k.plan = p;
+    }
+    HeadPlan& p = *k.plan;
+    if (p.count != count || p.head != head) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(gHeadMutex);
+    HeadSrc* s = headSrc(e->src, true);
+    if (!s) {  // the sources' table full of old ones: from the start
+        for (HeadSrc& h : gHeadSrc) {
+            for (u32 i = 0; i < h.n; i++) {
+                h.plans[i]->listed = false;
+            }
+        }
+        memset(gHeadSrc, 0, sizeof(gHeadSrc));
+        s = headSrc(e->src, true);
+    }
+    if (s && s->n < kHeadPerSrc) {
+        p.src = e->src;
+        p.listed = true;
+        p.lastUsed = gDirectFrames;
+        s->plans[s->n++] = &p;
+        gHeadStats.listed++;
+    }
+}
+
+// A split dynamic list's positions and normals from their arrays (as keptConvertPositions puts them in the
+// whole vertex), `head` bytes a vertex at out, and the box of the positions (min, max). False: a position
+// missing from its array (the whole conversion then: it keeps what the template has).
+bool keptConvertHead(const Format& f, const DrawArrays& arrays, const Kept& k, u32 count, u32 head, u8* out, float* box)
+{
+    if (gPackS8From < 0) {
+        const char* v = getenv("RE4_GX_PACKS8");
+        gPackS8From = v ? atoi(v) : 1;
+    }
+    if (gHeadFastFrom < 0) {
+        const char* v = getenv("RE4_GX_HEADFAST");
+        gHeadFastFrom = v ? atoi(v) : 1;
+    }
+    const bool s8 = f.nrmFormat == 1 && gPackS8From && gDirectFrames >= (u32) gPackS8From;
+    const Array& pos = arrays.a[0];
+    const Array& nrm = arrays.a[1];
+    const u32 posBytes = f.posBytes, nrmBytes = f.nrmComps * f.nrmCs;
+    const bool fast = f.posFormat == 3 && f.posComps == 3 && !(((uintptr_t) pos.base | pos.stride) & 1) &&
+                      !((uintptr_t) out & 3) && gHeadFastFrom && gDirectFrames >= (u32) gHeadFastFrom;
+    int ilo[3] = {32767, 32767, 32767}, ihi[3] = {-32768, -32768, -32768};
+    float lo[3] = {1e30f, 1e30f, 1e30f}, hi[3] = {-1e30f, -1e30f, -1e30f};
+    if (gHeadDirectFrom < 0) {
+        const char* v = getenv("RE4_GX_HEADDIRECT");
+        gHeadDirectFrom = v ? atoi(v) : 1;
+    }
+    if (fast && (head == 12 || s8) && gHeadDirectFrom && gDirectFrames >= (u32) gHeadDirectFrom) {
+        if (!k.posTop) {
+            k.posTop = keptTop(k.posIdx, count);
+        }
+        if (head == 16 && !k.nrmTop) {
+            k.nrmTop = keptTop(k.nrmIdx, count);
+        }
+        if (keptFits(pos, k.posTop, posBytes) && (head == 12 || keptFits(nrm, k.nrmTop, nrmBytes))) {
+            // (stage 41: the loop is headDirect, the skinning jobs' too)
+            headDirect(pos.base, pos.stride, k.posIdx, nrm.base, nrm.stride, k.nrmIdx, count, head, f.posScale, out,
+                       box);
+            gKeptStats.headFast += count;
+            gKeptStats.headDirect += count;
+            return true;
+        }
+    }
+    float p[kBlock * 3];
+    alignas(4) u8 packed[kBlock * 4];
+    float work[kBlock * 3];
+    for (u32 done = 0; done < count;) {
+        const u32 n = count - done < kBlock ? count - done : kBlock;
+        const u16* ix = k.posIdx + done;
+        for (u32 v = 0; v < n; v++) {
+            gBlock.pos[v] = at(pos, ix[v], posBytes);
+            if (!gBlock.pos[v]) {
+                return false;
+            }
+        }
+        if (!fast) {
+            f.posBlock[0]((u8*) p, 12, gBlock.pos, n, f.posScale);
+        }
+        if (head == 16) {
+            const u16* nx = k.nrmIdx + done;
+            bool all = true;
+            for (u32 v = 0; v < n; v++) {
+                gBlock.nrm[0][v] = at(nrm, nx[v], nrmBytes);
+                all = all && gBlock.nrm[0][v];
+            }
+            if (s8 && all) {
+                for (u32 v = 0; v < n; v++) {
+                    packNormalS8(gBlock.nrm[0][v], packed + 4 * v);
+                }
+            } else {  // (a missing element: its normal as the float path leaves it, as before)
+                memset(work, 0, sizeof(float) * 3 * n);
+                f.nrmPartBlock((u8*) work, 12, gBlock.nrm[0], n, f.nrmScale);
+                for (u32 v = 0; v < n; v++) {
+                    packNormal((const u8*) (work + 3 * v), packed + 4 * v);
+                }
+            }
+        }
+        if (fast) {
+            const float scale = f.posScale;
+            for (u32 v = 0; v < n; v++, out += head) {
+                const int16_t* q = (const int16_t*) gBlock.pos[v];
+                const int x = q[0], y = q[1], z = q[2];
+                ilo[0] = x < ilo[0] ? x : ilo[0];
+                ihi[0] = x > ihi[0] ? x : ihi[0];
+                ilo[1] = y < ilo[1] ? y : ilo[1];
+                ihi[1] = y > ihi[1] ? y : ihi[1];
+                ilo[2] = z < ilo[2] ? z : ilo[2];
+                ihi[2] = z > ihi[2] ? z : ihi[2];
+                float* o = (float*) out;
+                o[0] = (float) x * scale;
+                o[1] = (float) y * scale;
+                o[2] = (float) z * scale;
+                if (head == 16) {
+                    *(uint32_t*) (out + 12) = *(const uint32_t*) (packed + 4 * v);
+                }
+            }
+            done += n;
+            continue;
+        }
+        for (u32 v = 0; v < n; v++, out += head) {
+            const float* q = p + 3 * v;
+            for (int c = 0; c < 3; c++) {
+                lo[c] = q[c] < lo[c] ? q[c] : lo[c];
+                hi[c] = q[c] > hi[c] ? q[c] : hi[c];
+            }
+            memcpy(out, q, 12);
+            if (head == 16) {
+                memcpy(out + 12, packed + 4 * v, 4);
+            }
+        }
+        done += n;
+    }
+    if (fast && count) {
+        gKeptStats.headFast += count;
+        for (int c = 0; c < 3; c++) {
+            lo[c] = (float) ilo[c] * f.posScale;
+            hi[c] = (float) ihi[c] * f.posScale;
+        }
+    }
+    memcpy(box, lo, sizeof(lo));
+    memcpy(box + 3, hi, sizeof(hi));
+    return true;
+}
+
+// A list without room: why 0 over the budget, 1 the C heap, 2 the renderer
+void keptFailed(int why, u32 bytes)
+{
+    gKeptStats.failed++;
+    (why == 0 ? gKeptStats.failBudget : why == 1 ? gKeptStats.failHeap : gKeptStats.failRoom)++;
+    gKeptStats.failMax = bytes > gKeptStats.failMax ? bytes : gKeptStats.failMax;
+}
+
+// Room for `bytes` more in the budget: the lists not drawn in this frame go, the longest unused
+// first (their memory is freed once the GPU is past them: the next frame).
+void keptEvict(u32 bytes)
+{
+    while (gKeptBytes + bytes > kKeptBudget) {
+        auto oldest = gKept.end();
+        for (auto it = gKept.begin(); it != gKept.end(); ++it) {
+            if (it->second.vertices && it->second.lastFrame != gDirectFrames &&
+                (oldest == gKept.end() || it->second.lastFrame < oldest->second.lastFrame)) {
+                oldest = it;
+            }
+        }
+        if (oldest == gKept.end()) {
+            return;
+        }
+        keptDrop(oldest->second);
+        keptForget(oldest->first);
+        gKeptStats.evicted++;
+    }
+}
+
+// The list's draws as one triangle strip (stage 3.8: the PICA pays ~53 ns an index, not a triangle; a
+// triangle list holds 3 an triangle, a strip ~1): a GX strip as it is, the other draws' triangles a strip
+// of 3 each; joined by the last index and the next part's first (once more where the part would begin at
+// an odd place: its triangles would turn, and GX culls faces), the triangles between them without area.
+// The indices of the vertices one after the other, as writeIndices has them. RE4_3DS_STRIPS=0: none.
+std::vector<u32>* gStripStarts;  // (plan 5b) where each part begins in the strip, when wanted
+void stripAppend(std::vector<u16>& s, const u16* p, size_t n)
+{
+    if (!s.empty()) {
+        s.push_back(s.back());
+        s.push_back(p[0]);
+        if (s.size() & 1) {
+            s.push_back(p[0]);
+        }
+    }
+    if (gStripStarts) {
+        gStripStarts->push_back((u32) s.size());
+    }
+    s.insert(s.end(), p, p + n);
+}
+
+// Plan 5b: big static lists in pieces (RE4_3DS_PIECES=N indices a piece, 0 off; RE4_3DS_PIECESFROM=N)
+int gPieceIndices = -1;
+u32 gPiecesFrom;
+u32 gPieceGap = 384;  // RE4_3DS_PIECEGAP=N: at most N indices outside the view drawn between visible pieces (0: none)
+
+void piecesRead()
+{
+    if (gPieceIndices < 0) {
+        const char* e = getenv("RE4_3DS_PIECES");
+        gPieceIndices = e ? atoi(e) : 256;
+        const char* from = getenv("RE4_3DS_PIECESFROM");
+        gPiecesFrom = from ? (u32) atoi(from) : 1;
+        const char* gap = getenv("RE4_3DS_PIECEGAP");
+        gPieceGap = gap ? (u32) atoi(gap) : 384;
+    }
+}
+
+void keptStrip(const u8* list, u32 size, bool be, u32 inSize, std::vector<u16>& s)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char* e = getenv("RE4_3DS_STRIPS");
+        on = !e || *e != '0';
+    }
+    if (!on) {
+        return;
+    }
+    std::vector<u16> piece;
+    u32 v = 0;
+    for (u32 at = 0; at < size;) {
+        const u8 op = list[at];
+        if (op < 0x80) {
+            at++;
+            continue;
+        }
+        const u32 kind = op & 0xF8, count = rd16(list + at + 1, be);
+        if (kind == 0x98) {
+            if (count >= 3) {
+                piece.resize(count);
+                for (u32 i = 0; i < count; i++) {
+                    piece[i] = (u16) (v + i);
+                }
+                stripAppend(s, piece.data(), count);
+            }
+        } else {
+            piece.resize(indexCount(kind, count));
+            writeIndices(kind, count, v, piece.data());
+            for (size_t t = 0; t + 3 <= piece.size(); t += 3) {
+                stripAppend(s, piece.data() + t, 3);
+            }
+        }
+        v += count;
+        at += 3 + count * inSize;
+    }
+}
+
+// The strip (its vertices through `map`) where it is shorter than the triangle list of `kept` indices
+bool keptAsStrip(std::vector<u16>& strip, const std::vector<u16>& map, u32 kept)
+{
+    for (u16& i : strip) {
+        i = map[i];
+    }
+    const bool shorter = !strip.empty() && strip.size() < kept;
+    gKeptStats.stripIndices += shorter ? (u32) strip.size() : kept;
+    gKeptStats.listIndices += kept;
+    return shorter;
+}
+
+// (2026-11-18) The PICA's post-transform vertex cache: the list's triangles as strips made anew and in the order that
+// shades the fewest vertices (gx_restrip.h). RE4_3DS_VCACHE=0: the list's own strips, as before.
+int gVcache = -1;
+u32 gVcacheK = 24, gVcacheCut = 16;
+// The lists (keptList's address, the key's hash) met reordered in a state where the order matters: their own order
+// from then on (the same list drawn in two passes: with the depth written, then blended without)
+std::unordered_map<uintptr_t, u64> gKeptOwnOrder;
+
+// The state the list is drawn with now shows its triangles the same in any order: the depth test and update on with
+// an ordering compare, no logic op or subtraction (as sms-3ds orderWhy). Blending: the game draws nearly all (99 % of
+// the indices: BP 0x41 = 0x4bd, source alpha over, with the depth written) blended, its translucent parts apart
+// without the depth update; so with RE4_3DS_VCACHE=2 (the default) blending with the depth written counts as free -
+// the order shows only where a list's own triangles overlap with alpha below 1 (the list's order is not by depth
+// either); 1: no blending at all (next to nothing reordered).
+bool keptOrderFree()
+{
+    const u32 z = gGp.bp[0x40], c = gGp.bp[0x41];
+    const u32 fn = (z >> 1) & 7;  // never, less, equal, lequal, greater, nequal, gequal, always
+    if ((c & 2) || (c & (1u << 11)) || ((c & 1) && gVcache < 2)) {
+        return false;
+    }
+    return (z & 1) && (z & 0x10) && (fn == 1 || fn == 3 || fn == 4 || fn == 6);
+}
+
+// tri: the list's triangles (n indices); ix / kept / asStrip: the choice so far, replaced where the new strip is
+// cheaper (an index ~50 ns, a shaded vertex ~100 ns on the console); starts: the parts' beginnings then
+bool keptVcache(uintptr_t at, u64 keyHash, const u16* tri, u32 n, u32 count, std::vector<u16>& ix, u32& kept,
+                bool& asStrip, std::vector<u32>* starts)
+{
+    if (gVcache < 0) {
+        const char* e = getenv("RE4_3DS_VCACHE");
+        gVcache = e ? atoi(e) : 2;
+        const char* k = getenv("RE4_3DS_VCACHE_K");
+        gVcacheK = k && atoi(k) > 0 ? (u32) atoi(k) : 24;
+        const char* c = getenv("RE4_3DS_VCACHE_CUT");
+        gVcacheCut = c && atoi(c) > 0 ? (u32) atoi(c) : 16;
+    }
+    if (!gVcache || n < 6) {
+        return false;
+    }
+    // a small triangle list is staged by the renderer and joins the batch (stage 7.0, gx_3ds.cpp drawTimed:
+    // kUnkeepVertices 16, kUnkeepIndices 96 - the rain's drops, sprites); a strip would not: left as it is
+    if (!asStrip && count <= 16 && kept <= 96) {
+        gKeptStats.vcSmall++;
+        return false;
+    }
+    const auto own = gKeptOwnOrder.find(at);
+    if (!keptOrderFree() || (own != gKeptOwnOrder.end() && own->second == keyHash)) {
+        gKeptStats.vcOrder++;
+        gKeptStats.vcOrderIndices += kept;
+        return false;
+    }
+    const long long from = nowNs();
+    std::vector<u16> made;
+    std::vector<u32> madeStarts;
+    bool ok = false;
+    u32 before = 0, after = 0;
+    try {
+        ok = re4restrip::restrip(tri, n, count, gVcacheK, gVcacheCut, made, &madeStarts);
+        if (ok) {
+            before = re4restrip::shaded(ix.data(), kept, count, gVcacheK);
+            after = re4restrip::shaded(made.data(), (u32) made.size(), count, gVcacheK);
+        }
+    } catch (const std::bad_alloc&) {  // (the C heap: the list as it was)
+        gKeptStats.vcNoRoom++;
+        ok = false;
+    }
+    gKeptStats.vcNs += (u64) (nowNs() - from);
+    if (!ok) {
+        return false;
+    }
+    if (made.size() + 2 * (size_t) after >= kept + 2 * (size_t) before) {
+        gKeptStats.vcNoGain++;
+        return false;
+    }
+    gKeptStats.vcLists++;
+    gKeptStats.vcIndices[0] += kept;
+    gKeptStats.vcIndices[1] += (u32) made.size();
+    gKeptStats.vcShaded[0] += before;
+    gKeptStats.vcShaded[1] += after;
+    ix.swap(made);
+    kept = (u32) ix.size();
+    asStrip = true;
+    if (starts) {
+        starts->swap(madeStarts);
+    }
+    return true;
+}
+
+// A dynamic list: its vertices alike by their bytes in the list once, the indices to them.
+__attribute__((noinline)) bool keptBuildDynamic(Kept& k, const u8* list, u32 size, bool be, const Format& f, const DrawArrays& arrays,
+                      u32 vertices, u32 indices, u32 draws)
+{
+    const u32 in = f.inSize;
+    std::vector<u8> raw((size_t) vertices * in);
+    std::vector<u16> ix(indices);
+    u32 v = 0, i = 0;
+    for (u32 at = 0; at < size;) {
+        const u8 op = list[at];
+        if (op < 0x80) {
+            at++;
+            continue;
+        }
+        const u32 count = rd16(list + at + 1, be);
+        memcpy(raw.data() + (size_t) v * in, list + at + 3, (size_t) count * in);
+        writeIndices(op & 0xF8, count, v, ix.data() + i);
+        v += count;
+        i += (u32) indexCount(op & 0xF8, count);
+        at += 3 + count * in;
+    }
+    u32 slots = 1;
+    while (slots < vertices * 2) {
+        slots <<= 1;
+    }
+    std::vector<int> table(slots, -1);
+    std::vector<u16> map(vertices);
+    u32 count = 0;
+    for (u32 n = 0; n < vertices; n++) {
+        const u8* c = raw.data() + (size_t) n * in;
+        u32 s = (u32) hashBytes(c, in, 0) & (slots - 1);
+        while (table[s] >= 0 && memcmp(raw.data() + (size_t) table[s] * in, c, in) != 0) {
+            s = (s + 1) & (slots - 1);
+        }
+        if (table[s] < 0) {
+            memmove(raw.data() + (size_t) count * in, c, in);  // (count <= n: in place)
+            table[s] = (int) count++;
+        }
+        map[n] = (u16) table[s];
+    }
+    u32 kept = 0;
+    for (u32 t = 0; t + 3 <= indices; t += 3) {
+        const u16 a = map[ix[t]], b = map[ix[t + 1]], c = map[ix[t + 2]];
+        if (a != b && b != c && a != c) {
+            ix[kept++] = a;
+            ix[kept++] = b;
+            ix[kept++] = c;
+        }
+    }
+    std::vector<u16> strip;
+    keptStrip(list, size, be, in, strip);
+    const u32 listed = kept;  // (2026-11-18) the triangles' indices: in ix, in strip once swapped
+    bool asStrip = keptAsStrip(strip, map, kept);
+    if (asStrip) {
+        kept = (u32) strip.size();
+        ix.swap(strip);
+    }
+    k.reordered = false;
+    k.tris = listed / 3;
+    if (asStrip) {
+        k.reordered = keptVcache((uintptr_t) list | 1, k.keyHash, strip.data(), listed, count, ix, kept, asStrip, nullptr);
+    } else {
+        const std::vector<u16> tri(ix.begin(), ix.begin() + listed);
+        k.reordered = keptVcache((uintptr_t) list | 1, k.keyHash, tri.data(), listed, count, ix, kept, asStrip, nullptr);
+    }
+    // split (stage 3.8): the template's rest (all but the position and the normal) in the room, drawn from there
+    if (gSplitFrom < 0) {
+        const char* v = getenv("RE4_3DS_SPLIT");
+        gSplitFrom = v ? atoi(v) : 1;
+    }
+    const u32 head = keptHead(f), keptStride = f.stride - keptCut(f);
+    const bool split = gSkinTemplate && gSplitFrom && gDirect->drawSplit && f.posMode >= 2 && f.posComps == 3 &&
+                       (!(f.layout & RE4_GX_V_NORMAL) || (f.nrmMode >= 2 && !f.nbt3)) && keptStride > head;
+    const u32 restBytes = split ? count * (keptStride - head) : 0;
+    const u32 bytes = kept * 2 + restBytes;
+    keptEvict(bytes);
+    u16* w = nullptr;
+    u8* copy = (u8*) malloc((size_t) count * in);
+    void* room = copy && gKeptBytes + bytes <= kKeptBudget ? gDirect->keep(restBytes, kept, &w) : nullptr;
+    if (!room) {
+        free(copy);
+        k.retry = gDirectFrames + 2;
+        keptFailed(!copy ? 1 : gKeptBytes + bytes > kKeptBudget ? 0 : 2, bytes);
+        return false;
+    }
+    memcpy(copy, raw.data(), (size_t) count * in);
+    memcpy(w, ix.data(), (size_t) kept * 2);
+    k.vertices = room;
+    k.indices = w;
+    k.raw = copy;
+    k.fullHash = hashBytes(list, size, size);
+    if (gSkinTemplate) {
+        const u32 stride = f.stride - keptCut(f);
+        k.tmpl = (u8*) malloc((size_t) count * stride);
+        if (k.tmpl && !keptConvertWhole(f, arrays, k, count, k.tmpl)) {
+            free(k.tmpl);  // (2026-11-11) no room for the work buffer: without a template, as malloc failing
+            k.tmpl = nullptr;
+        }
+        if (k.tmpl && f.posMode >= 2) {
+            k.posIdx = (u16*) malloc((size_t) count * 2);
+            if (!k.posIdx) {
+                free(k.tmpl);
+                k.tmpl = nullptr;
+            } else {
+                const u32 o = (f.pnmtx ? 1 : 0) + f.mtxCount;  // the matrix indices come first
+                for (u32 n = 0; n < count; n++) {
+                    const u8* c = copy + (size_t) n * in + o;
+                    k.posIdx[n] = (u16) (f.posMode == 2 ? *c : rd16(c, be));
+                }
+            }
+        }
+        if (k.tmpl && f.nrmMode >= 2) {
+            // the normal's index after the position (NBT3, three of them: converted whole)
+            k.nrmIdx = f.nbt3 ? nullptr : (u16*) malloc((size_t) count * 2);
+            if (!k.nrmIdx) {
+                free(k.tmpl);
+                k.tmpl = nullptr;
+                free(k.posIdx);
+                k.posIdx = nullptr;
+            } else {
+                const u32 o = (f.pnmtx ? 1 : 0) + f.mtxCount + (f.posMode == 1 ? f.posBytes : indexSize(f.posMode));
+                for (u32 n = 0; n < count; n++) {
+                    const u8* c = copy + (size_t) n * in + o;
+                    k.nrmIdx[n] = (u16) (f.nrmMode == 2 ? *c : rd16(c, be));
+                }
+            }
+        }
+        k.full = !k.tmpl;
+        k.split = split && k.tmpl;
+        if (k.split) {  // the template's rest of each vertex into the room
+            const u32 rest = keptStride - head;
+            k.restHash = 0;
+            for (u32 n = 0; n < count; n++) {
+                memcpy((u8*) room + (size_t) n * rest, k.tmpl + (size_t) n * keptStride + head, rest);
+                k.restHash = hashBytes((const u8*) room + (size_t) n * rest, rest, k.restHash);
+            }
+            if (gSplitFrom == 1) {  // (else the template stays for the frames before)
+                free(k.tmpl);
+                k.tmpl = nullptr;
+            }
+        }
+    }
+    keptSeal(k, room, w);
+    k.bytes = bytes;
+    gKeptBytes += bytes;
+    k.gxDraws = draws;
+    k.gxVertices = vertices;
+    Re4GxDraw& d = k.draw;
+    d.primitive = (asStrip ? RE4_GX_TRIANGLE_STRIP : RE4_GX_TRIANGLES) | 0x90u << 8 | k.key.vat << 16 | RE4_GX_DIRECT_KEPT;
+    d.layout = gSkinTemplate ? keptLayout(f) : f.layout;
+    d.stride = gSkinTemplate ? f.stride - keptCut(f) : f.stride;
+    d.vertexOffset = 0;
+    d.vertexCount = count;
+    d.indexOffset = 0;
+    d.indexCount = kept;
+    gKeptStats.dynMade++;
+    gKeptStats.uniqueVertices += count;
+    gKeptStats.rawVertices += vertices;
+    return true;
+}
+
+// The list's draws converted into k (true), or why not (k.never, or k.retry: no room now).
+__attribute__((noinline)) bool keptBuild(Kept& k, const u8* list, u32 size, bool be, const Format& f, const DrawArrays& arrays)
+{
+    // the draws: all triangles of one vertex format, nothing else but NOPs
+    u32 vertices = 0, indices = 0, draws = 0;
+    for (u32 at = 0; at < size;) {
+        const u8 op = list[at];
+        if (op == 0x00 || op == 0x44 || op == 0x48) {
+            at++;
+            continue;
+        }
+        const u32 kind = op & 0xF8;
+        if (op < 0x80 || kind >= 0xA8 || (op & 7) != k.key.vat || size - at < 3) {
+            return false;
+        }
+        const u32 count = rd16(list + at + 1, be);
+        if (size - at - 3 < count * f.inSize) {
+            return false;
+        }
+        vertices += count;
+        indices += (u32) indexCount(kind, count);
+        draws++;
+        at += 3 + count * f.inSize;
+    }
+    // (the work buffers below are in the C heap; the indices u16) static: to 0xFFFF (plan 5b: r109's palisade,
+    // one list of 19094 vertices), changing arrays: 0x4000 (RE4_3DS_BIGLISTS=0: both 0x4000)
+    static int bigLists = -1;
+    if (bigLists < 0) {
+        const char* e = getenv("RE4_3DS_BIGLISTS");
+        bigLists = !(e && e[0] == '0');
+    }
+    if (vertices == 0 || vertices > (k.key.dynamic || !bigLists ? 0x4000u : 0xFFFFu)) {
+        return false;
+    }
+    if (k.key.dynamic) {
+        return keptBuildDynamic(k, list, size, be, f, arrays, vertices, indices, draws);
+    }
+    // converted one after the other, the indices of each draw after those before
+    std::vector<u8> out((size_t) vertices * f.stride);
+    std::vector<u16> ix(indices);
+    u32 v = 0, i = 0;
+    for (u32 at = 0; at < size;) {
+        const u8 op = list[at];
+        if (op < 0x80) {
+            at++;
+            continue;
+        }
+        const u32 count = rd16(list + at + 1, be);
+        convertVertices(f, arrays, list + at + 3, count, be, out.data() + (size_t) v * f.stride, gBlock);
+        writeIndices(op & 0xF8, count, v, ix.data() + i);
+        v += count;
+        i += (u32) indexCount(op & 0xF8, count);
+        at += 3 + count * f.inSize;
+    }
+    // in the kept layout (the normal packed), alike vertices once
+    const u32 stride = f.stride - keptCut(f);
+    u32 slots = 1;
+    while (slots < vertices * 2) {
+        slots <<= 1;
+    }
+    // (2026-11-08: the C heap ran out at such a build in r119) compacted in place in `out`: the vertex read first,
+    // its slot `count` (stride <= f.stride, count <= n) ends before vertex n + 1; the table freed after
+    u8 one[256];
+    if (f.stride > sizeof(one)) {
+        return false;
+    }
+    std::vector<int> table(slots, -1);
+    std::vector<u8>& unique = out;
+    std::vector<u16> map(vertices);
+    u32 count = 0;
+    for (u32 n = 0; n < vertices; n++) {
+        u8* c = unique.data() + (size_t) count * stride;
+        memcpy(one, out.data() + (size_t) n * f.stride, f.stride);
+        keptCompact(f, one, 1, c);
+        u32 s = (u32) hashBytes(c, stride, 0) & (slots - 1);
+        while (table[s] >= 0 && memcmp(unique.data() + (size_t) table[s] * stride, c, stride) != 0) {
+            s = (s + 1) & (slots - 1);
+        }
+        if (table[s] < 0) {
+            table[s] = (int) count++;
+        }
+        map[n] = (u16) table[s];
+    }
+    std::vector<int>().swap(table);
+    u32 kept = 0;
+    bool asStrip = false;
+    for (u32 t = 0; t + 3 <= indices; t += 3) {
+        const u16 a = map[ix[t]], b = map[ix[t + 1]], c = map[ix[t + 2]];
+        if (a != b && b != c && a != c) {  // the triangles that are lines or points left out
+            ix[kept++] = a;
+            ix[kept++] = b;
+            ix[kept++] = c;
+        }
+    }
+    std::vector<u16> strip;
+    std::vector<u32> starts;  // (plan 5b)
+    piecesRead();
+    gStripStarts = gPieceIndices > 0 ? &starts : nullptr;
+    keptStrip(list, size, be, f.inSize, strip);
+    gStripStarts = nullptr;
+    const u32 listed = kept;  // (2026-11-18) the triangles' indices: in ix, in strip once swapped
+    if (keptAsStrip(strip, map, kept)) {
+        kept = (u32) strip.size();
+        ix.swap(strip);
+        asStrip = true;
+    }
+    k.reordered = false;
+    k.tris = listed / 3;
+    if (asStrip) {
+        k.reordered = keptVcache((uintptr_t) list, k.keyHash, strip.data(), listed, count, ix, kept, asStrip, &starts);
+    } else {
+        const std::vector<u16> tri(ix.begin(), ix.begin() + listed);
+        k.reordered = keptVcache((uintptr_t) list, k.keyHash, tri.data(), listed, count, ix, kept, asStrip, &starts);
+    }
+    free(k.pieces);
+    k.pieces = nullptr;
+    k.nPieces = 0;
+    if (asStrip && gPieceIndices > 0 && kept >= 2u * (u32) gPieceIndices && !(keptLayout(f) & RE4_GX_V_MATRIX)) {
+        // cut at parts' beginnings (even places: the winding stays), ~N indices a piece, each its box
+        std::vector<Kept::Piece> pieces;
+        u32 from = 0;
+        for (size_t s = 0; s <= starts.size(); s++) {
+            const u32 at = s < starts.size() ? starts[s] : kept;
+            if (at > from && (at - from >= (u32) gPieceIndices || s == starts.size())) {
+                Kept::Piece p;
+                p.from = from;
+                p.count = at - from;
+                for (int c = 0; c < 3; c++) {
+                    p.lo[c] = 1e30f;
+                    p.hi[c] = -1e30f;
+                }
+                for (u32 i = from; i < at; i++) {
+                    const float* pos = (const float*) (unique.data() + (size_t) ix[i] * stride);
+                    for (int c = 0; c < 3; c++) {
+                        p.lo[c] = pos[c] < p.lo[c] ? pos[c] : p.lo[c];
+                        p.hi[c] = pos[c] > p.hi[c] ? pos[c] : p.hi[c];
+                    }
+                }
+                pieces.push_back(p);
+                from = at;
+            }
+        }
+        if (pieces.size() > 1) {
+            Kept::Piece all = pieces[0];  // (2026-11-18) the whole list's box after the last piece (keptPieces)
+            all.from = 0;
+            all.count = kept;
+            for (const Kept::Piece& p : pieces) {
+                for (int c = 0; c < 3; c++) {
+                    all.lo[c] = p.lo[c] < all.lo[c] ? p.lo[c] : all.lo[c];
+                    all.hi[c] = p.hi[c] > all.hi[c] ? p.hi[c] : all.hi[c];
+                }
+            }
+            pieces.push_back(all);
+            k.pieces = (Kept::Piece*) malloc(pieces.size() * sizeof(Kept::Piece));
+            pieces.pop_back();
+            if (k.pieces) {
+                k.pieces[pieces.size()] = all;
+                memcpy(k.pieces, pieces.data(), pieces.size() * sizeof(Kept::Piece));
+                k.nPieces = (u32) pieces.size();
+                gKeptStats.pieceLists++;
+            }
+        }
+    }
+    const u32 bytes = count * stride + kept * 2;
+    keptEvict(bytes);
+    u16* w = nullptr;
+    void* room = gKeptBytes + bytes <= kKeptBudget ? gDirect->keep(count * stride, kept, &w) : nullptr;
+    if (!room) {
+        k.retry = gDirectFrames + 2;
+        keptFailed(gKeptBytes + bytes > kKeptBudget ? 0 : 2, bytes);
+        return false;
+    }
+    memcpy(room, unique.data(), (size_t) count * stride);
+    memcpy(w, ix.data(), (size_t) kept * 2);
+    keptSeal(k, room, w);
+    k.bytes = bytes;
+    gKeptBytes += bytes;
+    k.gxDraws = draws;
+    k.gxVertices = vertices;
+    Re4GxDraw& d = k.draw;
+    d.primitive = (asStrip ? RE4_GX_TRIANGLE_STRIP : RE4_GX_TRIANGLES) | 0x90u << 8 | k.key.vat << 16 | RE4_GX_DIRECT_KEPT;
+    d.layout = keptLayout(f);
+    d.stride = stride;
+    d.vertexOffset = 0;
+    d.vertexCount = count;
+    d.indexOffset = 0;
+    d.indexCount = kept;
+    gKeptStats.made++;
+    gKeptStats.uniqueVertices += count;
+    gKeptStats.rawVertices += vertices;
+    return true;
+}
+
+// Plan 5b: a static list kept in pieces, the pieces outside the view left out (as gx_3ds.cpp outsideView: the box's
+// corners through the position matrix and the projection, all beyond one clip plane), the visible runs one draw each
+void keptPieces(const Kept& k, const Re4GxDraw& d)
+{
+    const float* m = (const float*) &gGp.xfMem[(d.matrices[0] & 0xFF) * 4];
+    const float* p = (const float*) &gGp.xfReg[0x20];
+    const bool persp = gGp.xfReg[0x26] == 0;
+    u32 runFrom = 0, runCount = 0, out = 0;
+    u32 gap = 0;  // (2026-11-18) indices outside the view since the run's last visible piece
+    {
+        // (2026-11-18) the whole list's box first (after the last piece): all of it within the view - one draw, no
+        // piece tested (with the new strips twice the lists are cut: bench7 350 -> 675 tests a frame on the GX thread)
+        const Kept::Piece& all = k.pieces[k.nPieces];
+        u32 any = 0;
+        for (int c = 0; c < 8 && !any; c++) {
+            const float x = c & 1 ? all.hi[0] : all.lo[0], y = c & 2 ? all.hi[1] : all.lo[1], z = c & 4 ? all.hi[2] : all.lo[2];
+            const float ex = m[0] * x + m[1] * y + m[2] * z + m[3];
+            const float ey = m[4] * x + m[5] * y + m[6] * z + m[7];
+            const float ez = m[8] * x + m[9] * y + m[10] * z + m[11];
+            const float cx = persp ? p[0] * ex + p[1] * ez : p[0] * ex + p[1];
+            const float cy = persp ? p[2] * ey + p[3] * ez : p[2] * ey + p[3];
+            const float cz = p[4] * ez + p[5];
+            const float cw = persp ? -ez : 1.0f;
+            any |= (cx > cw ? 1u : 0) | (cx < -cw ? 2u : 0) | (cy > cw ? 4u : 0) | (cy < -cw ? 8u : 0) |
+                   (cz > 0.0f ? 16u : 0) | (cz < -cw ? 32u : 0);
+        }
+        if (!any) {
+            gKeptStats.pieceWhole++;
+            gKeptStats.pieceRuns++;
+            gDirect->draw(&d, k.vertices, k.indices, gGp.bp, gGp.xfMem, gGp.xfReg);
+            return;
+        }
+    }
+    auto flush = [&]() {
+        if (runCount) {
+            Re4GxDraw r = d;
+            r.indexOffset = runFrom;
+            r.indexCount = runCount;
+            gKeptStats.pieceRuns++;
+            gDirect->draw(&r, k.vertices, k.indices, gGp.bp, gGp.xfMem, gGp.xfReg);
+            runCount = 0;
+        }
+    };
+    for (u32 n = 0; n < k.nPieces; n++) {
+        const Kept::Piece& pc = k.pieces[n];
+        u32 outside = 0x3F;
+        for (int c = 0; c < 8 && outside; c++) {
+            const float x = c & 1 ? pc.hi[0] : pc.lo[0], y = c & 2 ? pc.hi[1] : pc.lo[1], z = c & 4 ? pc.hi[2] : pc.lo[2];
+            const float ex = m[0] * x + m[1] * y + m[2] * z + m[3];
+            const float ey = m[4] * x + m[5] * y + m[6] * z + m[7];
+            const float ez = m[8] * x + m[9] * y + m[10] * z + m[11];
+            const float cx = persp ? p[0] * ex + p[1] * ez : p[0] * ex + p[1];
+            const float cy = persp ? p[2] * ey + p[3] * ez : p[2] * ey + p[3];
+            const float cz = p[4] * ez + p[5];
