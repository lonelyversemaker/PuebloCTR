+// AXAux.c __AXProcessAux's callbacks, on the buffers of the CPU's position of the frame
+void auxBehind(u32 position, u32 mode)
+{
+    void (*callbackA)(void*, void*);
+    void (*callbackB)(void*, void*);
+    void* contextA;
+    void* contextB;
+    s32* a;
+    s32* b;
+    re4_ax_aux(position, &callbackA, &contextA, &callbackB, &contextB, &a, &b);
+    if (callbackA) {
+        if (mode == 2) {
+            AX_AUX_DATA_DPL2 d;
+            d.l = a;
+            d.r = a + kFrame;
+            d.ls = a + 2 * kFrame;
+            d.rs = b + 2 * kFrame;
+            callbackA(&d.l, contextA);
+        } else {
+            AX_AUX_DATA d;
+            d.l = a;
+            d.r = a + kFrame;
+            d.s = a + 2 * kFrame;
+            callbackA(&d.l, contextA);
+        }
+    }
+    if (callbackB && mode != 2) {
+        AX_AUX_DATA d;
+        d.l = b;
+        d.r = b + kFrame;
+        d.s = b + 2 * kFrame;
+        callbackB(&d.l, contextB);
+    }
+}
