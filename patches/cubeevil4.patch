+// the list's voice chain (0x02)
+u32 listVoices(const u16* p)
+{
+    for (int guard = 0; guard < 384; guard++) {
+        switch (*p++) {
+        case 0x02:
+            return hilo(p[0], p[1]);
+        case 0x00:
+        case 0x07:
+        case 0x11:
+            p += 2;
+            break;
+        case 0x03:
+            break;
+        case 0x04:
+        case 0x05:
+        case 0x10:
+        case 0x12:
+        case 0x0E:
+            p += 4;
+            break;
+        case 0x13:
+            p += 12;
+            break;
+        default:
+            return 0;
+        }
+    }
+    return 0;
+}
