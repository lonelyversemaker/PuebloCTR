+// Deferred writing (re4_log_file_defer; the 3DS, stage 3.4: a write to the SD card takes about 12 ms, the 25 lines
+// of a frame report stopped the game for 300 ms, audible with the sound): the lines collect here (gFileLock) and
+// re4_log_file_drain writes them at once, from a thread of the app (gDrainLock: the file and its size are the
+// drain's then). A crash loses what was not drained yet.
+const size_t kPendingLimit = 1 << 20;
+bool gDefer;
+std::string gPending;
+size_t gPendingDropped;
+std::mutex gDrainLock;
+
+// Room ahead of the text (RE4_LOG_FILE_RESERVE bytes; the 3DS, stage 6.2e): each run starts a file of its own (the
+// last run's becomes <file>.1) and makes it that much long with zeros, before the game, so a write later finds its
+// place on the device: on the 3DS's SD card a free cluster took up to 1.2 s to find (r101-3ds-sdprobe1.log), a write
+// of 2 KB deep into a log file of 1.2 MB grown over many runs 60-150 ms, 1 MB of room after it 38 s
+// (r101-3ds-sdstall4.log), and the FS service does one request at a time: the game's reads waited. The text goes at
+// gFileSize, the zeros after it go at the end of the run (re4_log_file_trim) or, after a crash, when the file opens
+// again. 0: appended, as before.
+off_t gReserve;
+off_t gFileRoom;  // gReserve: the file's length on the device, the text and the zeros after it
+char gZeros[64 << 10];
+
+int openFlags()
+{
+    return gReserve ? O_RDWR | O_CREAT | O_CLOEXEC : O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC;
+}
+
+// `n` bytes at `at` of the file (gReserve: not opened to append).
+bool writeAt(const char* data, size_t n, off_t at)
+{
+    return lseek(gFile, at, SEEK_SET) == at && write(gFile, data, n) == (ssize_t) n;
+}
+
+// The file made `length` long with zeros.
+void makeRoom(off_t length)
+{
+    while (gFileRoom < length) {
+        size_t n = length - gFileRoom < (off_t) sizeof(gZeros) ? (size_t) (length - gFileRoom) : sizeof(gZeros);
+        if (!writeAt(gZeros, n, gFileRoom)) {
+            return;
+        }
+        gFileRoom += n;
+    }
+}
+
+// The zeros after the text off the file.
+void trim()
+{
+    if (gReserve && gFile >= 0 && gFileRoom > gFileSize && ftruncate(gFile, gFileSize) == 0) {
+        gFileRoom = gFileSize;
+    }
+}
+
+// Where the text of the file ends: before the zeros a run left (it did not trim them).
+off_t textEnd()
+{
+    static char buf[64 << 10];
+    off_t end = gFileRoom;
+    while (end > 0) {
+        const off_t from = end > (off_t) sizeof(buf) ? end - (off_t) sizeof(buf) : 0;
+        if (lseek(gFile, from, SEEK_SET) != from || read(gFile, buf, (size_t) (end - from)) != end - from) {
+            return gFileRoom;
+        }
+        for (off_t i = end - from; i > 0; i--) {
+            if (buf[i - 1]) {
+                return from + i;
+            }
+        }
+        end = from;
+    }
+    return 0;
+}
