-// The deal of one room: every record of its ITA once (see above).
-void dealRoom(SCE_AT_DATA* work, int num)
-{
-    const int wanted = wantedBits();
-    const bool on = (wanted & kItemRandom) && storyGame() && pG->pl_type != 1;
-    const u32 seed = (u32) (wanted & kSeedMask) >> kSeedShift;
-    int pool = 0, changed = 0, down = 0;
-    char list[600];
-    int len = 0;
-    list[0] = 0;
-    for (int i = 0; i < num; i++) {
-        SCE_AT_ITEM* r = (SCE_AT_ITEM*) ((u8*) work + i * sizeof(SCE_AT_DATA));
-        if (r->pad2[0] == kMark) {
-            continue;
-        }
-        r->pad2[0] = kMark;
-        SCE_AT_DATA_ITEM& it = r->item;
-        if (!on || r->id != SCEAT_ID_ITEM || r->waiting_type != 0 || it.ctrl_flag != 0) {
-            continue;
-        }
-        const unsigned old = it.item_id;
-        const int own = itemGroup(old);
-        if (own < 0) {
-            continue;
-        }
-        pool++;
-        u32 h = mix(seed * 0x9E3779B1u ^ mix((u32) pG->room_id << 16 | (u32) i << 8 | old));
-        // the group by its share, then the first group from there with a model in the room
-        int pick = (int) (h % 100), g = 0;
-        while (g < kGroups - 1 && pick >= kShare[g]) {
-            pick -= kShare[g];
-            g++;
-        }
-        u8 cand[256];
-        int n = 0;
-        for (int k = 0; k < kGroups && n == 0; k++) {
-            n = groupCandidates((g + k) % kGroups, cand);
-            if (n) {
-                g = (g + k) % kGroups;
-            }
-        }
-        if (n == 0) {
-            continue;
-        }
-        h = mix(h);
-        const unsigned id = cand[h % (u32) n];
-        if (id == old) {
-            continue;  // drawn as it was: its count stays
-        }
-        const u16 count = itemCount(id, mix(h));
-        changed++;
-        if (len < (int) sizeof(list) - 40) {
-            len += snprintf(list + len, sizeof(list) - len, "%s area 0x%02x 0x%02x x%u -> 0x%02x x%u (%s)",
-                            changed > 1 ? "," : ":", (unsigned) r->no, old, (unsigned) it.item_num, id,
-                            (unsigned) count, kGroupName[g]);
-        }
-        it.item_id = (u16) id;
-        it.item_num = count;
-        // the new model put down onto the surface below, as the game puts down the items enemies drop (sceAtSetItem:
-        // EatMgr.getFloor): the records hold the old item a little above it (r227, the crate by the merchant: 49..57
-        // units, the boxes' flat models hide it; a herb's pot or a grenade there stood in the air, the project owner's
-        // Retroid screenshot 08.11.2026). Only within kRestAbove: farther down is a floor under furniture without
-        // collision, where the item stays as the record has it
-        const f32 floor = EatMgr.getFloor(&it.item_pos, 0, 0.0f, 100000.0f, 0);
-        if (floor <= it.item_pos.y && it.item_pos.y - floor <= kRestAbove) {
-            down += it.item_pos.y > floor ? 1 : 0;
-            it.item_pos.y = floor;
-        }
-    }
-    if (on) {
-        re4_log("cheat: random items in r%03x (seed %u): %d of %d items of the pool changed (%d put down onto the "
-                "surface below), %d records%s",
-                (unsigned) pG->room_id, (unsigned) seed, changed, pool, down, num, list);
-    }
-}
