+        const float d = (sph.pos.x - o.x) * h->normal[i].x + (sph.pos.y - o.y) * h->normal[i].y +
+                        (sph.pos.z - o.z) * h->normal[i].z;
+        out = d > sph.radius + 0.01f;
+    }
+    gVcTested++;
+    gVcOut += out;
+    if (pG->Frame_cnt / 600 != gVcFrame) {
+        gVcFrame = pG->Frame_cnt / 600;
+        re4_log("esp view cull (frame %u): %u plain sprites tested, %u wholly outside the view (%s)",
+                (unsigned) pG->Frame_cnt, gVcTested, gVcOut, gViewCull == 1 ? "left out" : "counted only");
+        gVcTested = gVcOut = 0;
+    }
+    return gViewCull == 1 ? out : 0;
+}
