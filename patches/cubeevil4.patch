diff --git a/port/whole/runtime/mtx_ps.c b/port/whole/runtime/mtx_ps.c
index 641665805..100221541 100644
--- a/port/whole/runtime/mtx_ps.c
+++ b/port/whole/runtime/mtx_ps.c
@@ -5,0 +6 @@
+#define RE4_SDK_PS_DEFINITIONS /* the PS* functions below, not the inline ones of mtx.h (patch 0160) */
@@ -7,0 +9,63 @@
+/* The SDK's C_MTXConcat (src/lib/mtx.c; whole_prepare.py SDK_C_REPLACED leaves it
+ * out of sdk_c/): the same sums in the same order, so the same bits. The SDK's
+ * writes go through ab, and with -fno-strict-aliasing every one of them makes the
+ * compiler read a and b again: twelve chains one after another, the ARM11's VFP
+ * waiting on each (stage 3.6, the hottest function of the village). Here a and b
+ * are read once, and ab == a or b needs no temporary matrix. */
+void C_MTXConcat(const Mtx a, const Mtx b, Mtx ab) {
+    f32 a00 = a[0][0], a01 = a[0][1], a02 = a[0][2], a03 = a[0][3];
+    f32 a10 = a[1][0], a11 = a[1][1], a12 = a[1][2], a13 = a[1][3];
+    f32 a20 = a[2][0], a21 = a[2][1], a22 = a[2][2], a23 = a[2][3];
+    f32 b00 = b[0][0], b01 = b[0][1], b02 = b[0][2], b03 = b[0][3];
+    f32 b10 = b[1][0], b11 = b[1][1], b12 = b[1][2], b13 = b[1][3];
+    f32 b20 = b[2][0], b21 = b[2][1], b22 = b[2][2], b23 = b[2][3];
+    f32 m00 =   0 + a02 * b20 + ((a00 * b00) + (a01 * b10));
+    f32 m01 =   0 + a02 * b21 + ((a00 * b01) + (a01 * b11));
+    f32 m02 =   0 + a02 * b22 + ((a00 * b02) + (a01 * b12));
+    f32 m03 = a03 + (a02 * b23 +  (a00 * b03  + (a01 * b13)));
+    f32 m10 =   0 + a12 * b20 + ((a10 * b00) + (a11 * b10));
+    f32 m11 =   0 + a12 * b21 + ((a10 * b01) + (a11 * b11));
+    f32 m12 =   0 + a12 * b22 + ((a10 * b02) + (a11 * b12));
+    f32 m13 = a13 + (a12 * b23 +  (a10 * b03  + (a11 * b13)));
+    f32 m20 =   0 + a22 * b20 + ((a20 * b00) + (a21 * b10));
+    f32 m21 =   0 + a22 * b21 + ((a20 * b01) + (a21 * b11));
+    f32 m22 =   0 + a22 * b22 + ((a20 * b02) + (a21 * b12));
+    f32 m23 = a23 + (a22 * b23 +  (a20 * b03  + (a21 * b13)));
+    ab[0][0] = m00; ab[0][1] = m01; ab[0][2] = m02; ab[0][3] = m03;
+    ab[1][0] = m10; ab[1][1] = m11; ab[1][2] = m12; ab[1][3] = m13;
+    ab[2][0] = m20; ab[2][1] = m21; ab[2][2] = m22; ab[2][3] = m23;
+}
+
+/* The SDK's C_MTXInverse the same way (its writes made it read src again). */
+u32 C_MTXInverse(const Mtx src, Mtx inv) {
+    f32 s00 = src[0][0], s01 = src[0][1], s02 = src[0][2], s03 = src[0][3];
+    f32 s10 = src[1][0], s11 = src[1][1], s12 = src[1][2], s13 = src[1][3];
+    f32 s20 = src[2][0], s21 = src[2][1], s22 = src[2][2], s23 = src[2][3];
+    f32 det = ((((s21 * (s02 * s10))
+               + ((s22 * (s00 * s11))
+                + (s20 * (s01 * s12))))
+                - (s02 * (s20 * s11)))
+                - (s22 * (s10 * s01)))
+                - (s12 * (s00 * s21));
+    if (0 == det) {
+        return 0;
+    }
+    det = 1 / det;
+    f32 m00 = (det * +((s11 * s22) - (s21 * s12)));
+    f32 m01 = (det * -((s01 * s22) - (s21 * s02)));
+    f32 m02 = (det * +((s01 * s12) - (s11 * s02)));
+    f32 m10 = (det * -((s10 * s22) - (s20 * s12)));
+    f32 m11 = (det * +((s00 * s22) - (s20 * s02)));
+    f32 m12 = (det * -((s00 * s12) - (s10 * s02)));
+    f32 m20 = (det * +((s10 * s21) - (s20 * s11)));
+    f32 m21 = (det * -((s00 * s21) - (s20 * s01)));
+    f32 m22 = (det * +((s00 * s11) - (s10 * s01)));
+    f32 m03 = ((-m00 * s03) - (m01 * s13)) - (m02 * s23);
+    f32 m13 = ((-m10 * s03) - (m11 * s13)) - (m12 * s23);
+    f32 m23 = ((-m20 * s03) - (m21 * s13)) - (m22 * s23);
+    inv[0][0] = m00; inv[0][1] = m01; inv[0][2] = m02; inv[0][3] = m03;
+    inv[1][0] = m10; inv[1][1] = m11; inv[1][2] = m12; inv[1][3] = m13;
+    inv[2][0] = m20; inv[2][1] = m21; inv[2][2] = m22; inv[2][3] = m23;
+    return 1;
+}
+
