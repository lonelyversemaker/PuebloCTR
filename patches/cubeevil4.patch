+// ---------------------------------------- the lists behind: the queue
+void runBehind(BehindFrame& f)
+{
+    for (u32 i = 0; i < f.depops; i++) {
+        addDepop(gState[f.depop[i]].dpop);
+    }
+    for (int b = 0; b < kBuses; b++) {
+        fadeDepop(b);
+    }
+    auxBehind(f.auxPosition, f.mode);
+    gRunning = &f;
+    gBehindRun = true;
+    run(f.list);
+    gBehindRun = false;
+}
+
+// the worker (or the game's thread without one): the lists queued, in order
+void runQueued()
+{
+    for (u32 n = gBehindDone.load(std::memory_order_relaxed); n != gBehindPosted.load(std::memory_order_acquire);
+         n++) {
+        if (gAramQ) {
+            aramApply(n, false);  // (RE4_SND_ARAMQ: the ARAM writes queued before this list)
+        }
+        runBehind(gBehindFrames[n % kBehind]);
+        gBehindDone.store(n + 1, std::memory_order_release);
+    }
